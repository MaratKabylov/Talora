NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Prefer a modern Supabase secret key (sb_secret_...).
SUPABASE_SECRET_KEY=

# Legacy server-only fallback. Never expose either key to browser code.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Safe JSON performance events in server logs and browser Web Vitals reporting.
# Enable both values in staging when collecting a baseline.
PERFORMANCE_TELEMETRY_ENABLED=false
NEXT_PUBLIC_PERFORMANCE_TELEMETRY_ENABLED=false

# Server only. Apply BOTH session lease and answer V2 migrations before enabling.
# Covers claim, heartbeat, events, autosave/finalize and expiration checks.
# Enable in staging first; completion/scoring still uses the existing pipeline.
SESSION_CONTROL_V2=false

# Server only. Apply 20260906140000_assessment_section_read_v2.sql before enabling.
# Limits test-page content/answers to the active section. Independent of write V2.
ASSESSMENT_SECTION_READ_V2=false

# Server only. Apply 20260907120000_assessment_test_overview_v2.sql before enabling.
# Use with ASSESSMENT_SECTION_READ_V2 for fully bounded test-page reads.
ASSESSMENT_OVERVIEW_V2=false

# Server only. Requires ASSESSMENT_SECTION_READ_V2=true.
# No new migration. Keeps the session mounted when loading another section.
ASSESSMENT_SOFT_NAVIGATION_V2=false

# Server only. Extends soft navigation to whole-section mode after the batch migration.
# Apply 20260907150000_assessment_section_save_v2.sql; requires all three flags above
# SESSION_CONTROL_V2, ASSESSMENT_SECTION_READ_V2, ASSESSMENT_SOFT_NAVIGATION_V2=true.
ASSESSMENT_SECTION_SAVE_V2=false

# Server only. Apply 20260907170000_assessment_section_prefetch_v3.sql first.
# Requires SECTION_READ_V2 + SOFT_NAVIGATION_V2; section mode also needs SECTION_SAVE_V2 + SESSION_CONTROL_V2.
# Prefetches only next immutable content; every transition revalidates live state.
ASSESSMENT_SECTION_PREFETCH_V3=false

# Reserved for a later email invitation milestone.
RESEND_API_KEY=
EMAIL_FROM=

